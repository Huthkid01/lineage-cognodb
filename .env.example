# CognoDB Cloud (console.cognodb.com)
# Username is always "cognodb" on the free tier unless you change it.
COGNODB_URI=bolt+s://YOUR-INSTANCE-ID.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=paste-the-password-shown-once-at-provisioning

# Optional: set to "true" to allow the seed script to wipe the graph first.
# SEED_RESET=true
